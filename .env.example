# 复制为 .env 后按实际环境填写；进程环境优先，生产秘密不得提交到 Git。
# 部署品牌名称；仓库/包名仍保持 typeapp。
# 项目官方网站：https://iots.top，仅用于项目说明。
APP_NAME=TypeApp
APP_ENV=production
# bin/typeapp 显式使用 development；只有该开发入口且本项为 true 时记录安全调试位置。
APP_DEBUG=false
APP_LISTEN=127.0.0.1
APP_PORT=9501
# 本地联调使用回环地址；对外部署时填写实际业务域名及端口。
APP_ALLOWED_HOSTS=127.0.0.1:9501,localhost:9501
APP_TRUSTED_PROXIES=
# 空库先执行 app:install，管理与客户口令仅从受控进程环境临时提供，不写入本文件。
APP_UPLOAD_TEMP=

# IoT设备接入是独立角色，要求PostgreSQL同步备库、显式迁移和真实TLS。
# 命令数组指向当前应用入口；例如原生部署根中的 ["./type-app"]，不经过shell。
IOT_MQTT_COMMAND=
# 独立 Broker 管理角色：broker:install、broker:user、broker:serve；管理HTTP沿用APP_*及DB_*。
# 初始化密码 BROKER_ADMIN_PASSWORD 通过受控环境临时提供，不能使用 MQTT 接入密码。
BROKER_LISTEN=127.0.0.1
BROKER_PORT=8883
BROKER_NODE_ID=default
BROKER_IO_DRIVER=swoole
BROKER_PLAINTEXT=false
# 0 表示关闭。明文 WS 仅在 BROKER_PLAINTEXT=true 时有效；WSS 与 TCP TLS 共用证书。
BROKER_WS_PORT=0
BROKER_WSS_PORT=0
BROKER_ALLOWED_ORIGINS=
BROKER_CERTIFICATE=
BROKER_PRIVATE_KEY=
# 0 表示关闭。专用 mTLS 与凭据 TLS 入口分开，需要可读客户端 CA 文件；在线登记的 CA/证书绑定管理库，不热重载本文件。
BROKER_MTLS_PORT=0
BROKER_CLIENT_CA=
BROKER_CLIENT_USERNAME=
BROKER_CLIENT_PASSWORD=
BROKER_TOPIC_PREFIX=
# 可靠接收显式配置当前应用命令数组与PostgreSQL同步备库，并先执行broker:store-install。
BROKER_COMMAND=
BROKER_STANDBY_NAMES=
# 专用只读探针令牌，至少32字符；为空关闭健康和Prometheus入口，不使用管理人员令牌。
BROKER_PROBE_TOKEN=
# 原生就绪通知复用MQTT状态机；stream仅用于小规模，选择时同时把物理连接上限降至512以内。
IOT_MQTT_IO_DRIVER=swoole
IOT_MQTT_MAXIMUM_CONNECTIONS=10100
IOT_MQTT_MAXIMUM_DEVICE_CONNECTIONS=10000
IOT_MQTT_MAXIMUM_SERVICE_CONNECTIONS=100
IOT_MQTT_MAXIMUM_SESSIONS=20000
# 额度只能调低；条数与逻辑字节数先满生效，设备不能占用服务预留。
IOT_MQTT_MAXIMUM_PENDING_MESSAGES=2000000
IOT_MQTT_MAXIMUM_PENDING_BYTES=4294967296
IOT_MQTT_MAXIMUM_SHARED_MESSAGES=1000000
IOT_MQTT_MAXIMUM_SHARED_BYTES=2147483648
IOT_MQTT_MAXIMUM_DEVICE_MESSAGES=10000
IOT_MQTT_MAXIMUM_DEVICE_BYTES=16777216
IOT_MQTT_MAXIMUM_APPLICATION_MESSAGES=1000000
IOT_MQTT_MAXIMUM_APPLICATION_BYTES=2147483648
IOT_MQTT_LISTEN=127.0.0.1
IOT_MQTT_PORT=8883
# 0 表示关闭。物联角色默认 TLS，明文 WS 需要同时具备明文调试配置；WSS 与 MQTT TLS 共用证书。
IOT_MQTT_WS_PORT=0
IOT_MQTT_WSS_PORT=0
IOT_MQTT_ALLOWED_ORIGINS=
IOT_MQTT_NODE_ID=default
IOT_MQTT_CLUSTERED=false
IOT_MQTT_STANDBY=iot_sync
# Patroni的稳定节点白名单可填pg_one,pg_two,pg_three；仍须恰好一个当前合格同步备库。
# 相对证书路径基于APP_BASE_PATH；口令只在运行环境提供。
IOT_MQTT_CERTIFICATE=
IOT_MQTT_PRIVATE_KEY=
IOT_MQTT_PRIVATE_KEY_PASSPHRASE=
# 0 表示关闭。物联专用 mTLS 同样需要客户端 CA 文件；证书到设备主体的绑定走授权版本。
IOT_MQTT_MTLS_PORT=0
IOT_MQTT_CLIENT_CA=

# 服务与设备凭据分离。Broker只提供32位hex凭据ID和64位hex SHA-256验证值；消费进程才提供密码。
# 更换凭据使用新ID并重启所有Broker及消费进程；当前配置不提供运行中热撤销。
IOT_INGESTION_CREDENTIAL_ID=
IOT_INGESTION_SECRET_HASH=
IOT_INGESTION_PASSWORD=
IOT_INGESTION_HOST=127.0.0.1
IOT_INGESTION_PORT=8883
IOT_INGESTION_INSTANCE=default
# host为IP，证书DNS名可用peer_name指定；CA相对APP_BASE_PATH，TLS强制验证。
IOT_INGESTION_CA=
IOT_INGESTION_PEER_NAME=

# 可运行设备角色iot:device；每台设备使用独立缓存文件，父目录须预先存在，相对APP_BASE_PATH。
# 默认额度满足1KB/10秒的24小时纯载荷基线；改变额度不能静默复用旧缓存文件。
IOT_DEVICE_ID=
IOT_DEVICE_OWNERSHIP_ID=
IOT_DEVICE_TENANT_ID=
IOT_DEVICE_MODEL_VERSION=1
# 明确支持的目标模型版本到结构摘要的JSON对象；缺省不接受任何模型切换。
IOT_DEVICE_SUPPORTED_MODELS={}
IOT_DEVICE_CREDENTIAL_ID=
IOT_DEVICE_PASSWORD=
IOT_DEVICE_CACHE=
IOT_DEVICE_MAXIMUM_RECORDS=8640
IOT_DEVICE_MAXIMUM_BYTES=8640000
IOT_DEVICE_HOST=127.0.0.1
IOT_DEVICE_PORT=8883
IOT_DEVICE_CA=
IOT_DEVICE_PEER_NAME=

# 导出目录相对APP_BASE_PATH；HTTP和后台角色共享同一私有目录。
# 队列Redis使用可靠noeviction实例，不能复用可淘汰缓存实例。
IOT_EXPORT_DIRECTORY=storage/exports
IOT_EXPORT_NAMESPACE=typeapp-iot
IOT_EXPORT_REDIS_HOST=127.0.0.1
IOT_EXPORT_REDIS_PORT=6379
IOT_EXPORT_REDIS_USERNAME=
IOT_EXPORT_REDIS_PASSWORD=
IOT_EXPORT_REDIS_TLS=false
IOT_EXPORT_REDIS_CA=

# 站内通知使用独立持久Redis队列。HTTP、告警确认与保留清理不连接此实例。
IOT_NOTICES_REDIS_HOST=127.0.0.1
IOT_NOTICES_REDIS_PORT=6379
IOT_NOTICES_REDIS_USERNAME=
IOT_NOTICES_REDIS_PASSWORD=
IOT_NOTICES_REDIS_TLS=false
# CA相对APP_BASE_PATH；TLS验证服务器身份。
IOT_NOTICES_REDIS_CA=
IOT_NOTICES_NAMESPACE=typeapp-iot

# SQLite 默认无需外部数据库；首次安装由 app:install 创建数据目录、模式和双端初始身份。
DB_DRIVER=sqlite
DB_SQLITE_FILE=build/app/runtime/typeapp.sqlite
DB_HOST=127.0.0.1
# 0 表示 MySQL 3306、PostgreSQL 5432；SQLite 不使用此值。
DB_PORT=0
DB_DATABASE=typeapp
DB_USERNAME=typeapp
DB_PASSWORD=
DB_TLS_CA=
DB_SERVER_BUDGET=100
DB_ADMIN_RESERVE=10
APP_MAX_REPLICAS=1
APP_ROLLING_SURGE=1
APP_DATABASE_PROCESSES=1
# 每进程最大同时占用连接的线程数，含主线程和未 join 的旧代。
APP_DATABASE_THREADS=2
DB_POOL_WAITERS=64
DB_POOL_WAIT_MS=1000

# 首页缓存默认关闭；显式开启前先配置独立测试或应用 Redis。
APP_CACHE_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_CA=
