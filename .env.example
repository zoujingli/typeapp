# 复制为 .env 后按实际环境填写；进程环境优先，生产秘密不得提交到 Git。
# 部署品牌名称；仓库/包名仍保持 typeapp。
# 项目官方网站：https://iots.top，仅用于项目说明。
APP_NAME=TypeApp
APP_ENV=prod
# 只接受 dev/prod/demo，缺省 prod；demo 拒绝 HTTP 业务写入，后台任务须由运维暂停。
# 仅 APP_ENV=dev、bin/typeapp 开发入口且本项为 true 时记录安全调试位置。
APP_DEBUG=false
APP_LISTEN=127.0.0.1
APP_PORT=9501
# 本地联调使用回环地址；对外部署时填写实际业务域名及端口。
APP_ALLOWED_HOSTS=127.0.0.1:9501,localhost:9501
APP_TRUSTED_PROXIES=
# 空库先执行 app:install，管理与客户口令仅从受控进程环境临时提供，不写入本文件。
APP_UPLOAD_TEMP=
# HTTP 执行线程与连接部署计划分开；以下请求/连接额度均属于单个 HTTP 执行者。
APP_HTTP_THREADS=2
APP_HTTP_MAX_REQUESTS=64
APP_HTTP_MAX_CONNECTIONS=256
APP_HTTP_REQUEST_MS=30000
APP_HTTP_DRAIN_MS=5000
APP_HTTP_CLEANUP_MS=1000

# IoT设备接入是独立角色，要求PostgreSQL同步备库、显式迁移和真实TLS。
# 命令数组指向当前应用入口；例如原生部署根中的 ["./type-app"]，不经过shell。
IOT_MQTT_COMMAND=
# 独立 Broker 管理角色：broker:install、broker:user、broker:serve；管理HTTP沿用APP_*及DB_*。
# 初始化密码 BROKER_ADMIN_PASSWORD 通过受控环境临时提供，不能使用 MQTT 接入密码。
BROKER_LISTEN=127.0.0.1
BROKER_PORT=8883
BROKER_NODE_ID=default
BROKER_IO_DRIVER=swoole
BROKER_PLAINTEXT=false
# 0 表示关闭。明文 WS 仅在 BROKER_PLAINTEXT=true 时有效；WSS 与 TCP TLS 共用证书。
BROKER_WS_PORT=0
BROKER_WSS_PORT=0
BROKER_ALLOWED_ORIGINS=
BROKER_CERTIFICATE=
BROKER_PRIVATE_KEY=
# 0 表示关闭。专用 mTLS 与凭据 TLS 入口分开，需要可读客户端 CA 文件；在线登记的 CA/证书绑定管理库，不热重载本文件。
BROKER_MTLS_PORT=0
BROKER_CLIENT_CA=
BROKER_CLIENT_USERNAME=
BROKER_CLIENT_PASSWORD=
BROKER_TOPIC_PREFIX=
# 可靠接收显式配置当前应用命令数组与PostgreSQL同步备库，并先执行broker:store-install。
BROKER_COMMAND=
BROKER_STANDBY_NAMES=
# 专用只读探针令牌，至少32字符；为空关闭健康和Prometheus入口，不使用管理人员令牌。
BROKER_PROBE_TOKEN=
# 原生就绪通知复用MQTT状态机；通信统一使用随应用交付的Swoole运行库。
IOT_MQTT_IO_DRIVER=swoole
IOT_MQTT_MAXIMUM_CONNECTIONS=10100
IOT_MQTT_MAXIMUM_DEVICE_CONNECTIONS=10000
IOT_MQTT_MAXIMUM_SERVICE_CONNECTIONS=100
IOT_MQTT_MAXIMUM_SESSIONS=20000
# 额度只能调低；条数与逻辑字节数先满生效，设备不能占用服务预留。
IOT_MQTT_MAXIMUM_PENDING_MESSAGES=2000000
IOT_MQTT_MAXIMUM_PENDING_BYTES=4294967296
IOT_MQTT_MAXIMUM_SHARED_MESSAGES=1000000
IOT_MQTT_MAXIMUM_SHARED_BYTES=2147483648
IOT_MQTT_MAXIMUM_DEVICE_MESSAGES=10000
IOT_MQTT_MAXIMUM_DEVICE_BYTES=16777216
IOT_MQTT_MAXIMUM_APPLICATION_MESSAGES=1000000
IOT_MQTT_MAXIMUM_APPLICATION_BYTES=2147483648
IOT_MQTT_LISTEN=127.0.0.1
IOT_MQTT_PORT=8883
# 0 表示关闭。物联角色默认 TLS，明文 WS 需要同时具备明文调试配置；WSS 与 MQTT TLS 共用证书。
IOT_MQTT_WS_PORT=0
IOT_MQTT_WSS_PORT=0
IOT_MQTT_ALLOWED_ORIGINS=
IOT_MQTT_NODE_ID=default
IOT_MQTT_CLUSTERED=false
IOT_MQTT_STANDBY=iot_sync
# Patroni的稳定节点白名单可填pg_one,pg_two,pg_three；仍须恰好一个当前合格同步备库。
# 相对证书路径基于APP_BASE_PATH；口令只在运行环境提供。
IOT_MQTT_CERTIFICATE=
IOT_MQTT_PRIVATE_KEY=
IOT_MQTT_PRIVATE_KEY_PASSPHRASE=
# 0 表示关闭。物联专用 mTLS 同样需要客户端 CA 文件；证书到设备主体的绑定走授权版本。
IOT_MQTT_MTLS_PORT=0
IOT_MQTT_CLIENT_CA=

# 维护调度只在显式 app:schedule 命令中运行，Redis 使用持久 noeviction 实例。
APP_SCHEDULER_NAMESPACE=typeapp-iot
APP_SCHEDULER_REDIS_HOST=127.0.0.1
APP_SCHEDULER_REDIS_PORT=6379
APP_SCHEDULER_REDIS_USERNAME=
APP_SCHEDULER_REDIS_PASSWORD=
APP_SCHEDULER_REDIS_TLS=false
APP_SCHEDULER_REDIS_CA=

# SQLite 默认无需外部数据库；首次安装由 app:install 创建数据目录、模式和双端初始身份。
DB_DRIVER=sqlite
DB_SQLITE_FILE=build/app/runtime/typeapp.sqlite
DB_HOST=127.0.0.1
# 0 表示 MySQL 3306、PostgreSQL 5432；SQLite 不使用此值。
DB_PORT=0
DB_DATABASE=typeapp
DB_USERNAME=typeapp
DB_PASSWORD=
DB_TLS_CA=
DB_SERVER_BUDGET=100
DB_ADMIN_RESERVE=10
APP_MAX_REPLICAS=1
APP_ROLLING_SURGE=1
# 每副本同时存在的全部数据库角色及子进程；按实际拓扑调整，不能仅填写 HTTP 进程数。
APP_DATABASE_PROCESSES=8
# 每进程最大同时占用连接的线程数，含主线程和未 join 的旧代。
APP_DATABASE_THREADS=2
DB_POOL_CAPACITY=4
# 默认不保留空闲连接；驱动不承诺完整清洗时仍安全退役。
DB_POOL_IDLE=0
DB_POOL_WAITERS=64
DB_POOL_WAIT_MS=1000

# Redis 沿用同一副本/角色/线程计划，所有用途共享分额；端点配置见通知、导出、调度各组。
REDIS_SERVER_BUDGET=256
REDIS_ADMIN_RESERVE=16
REDIS_POOL_CAPACITY=4
# 物联中心没有通用查询缓存开关；旧 APP_CACHE_ENABLED=true 会明确拒绝。
