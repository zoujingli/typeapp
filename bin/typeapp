#!/usr/bin/env php
<?php

declare(strict_types=1);

// 本地开发 CLI；生产执行 build/app/type-app，禁止以此启动器作源码解释回退。
$root = dirname(__DIR__);
try {
    if (!chdir($root)) {
        throw new RuntimeException('无法切换到 TypeApp 项目根目录');
    }
    $command = $argv[1] ?? 'help';
    $help = in_array($command, ['help', '--help'], true)
        || ($command === 'migrate' && (count($argv) === 2 || (count($argv) === 3 && $argv[2] === 'help')));
    if (!$help) {
        require __DIR__ . '/typeapp-prepare';
        $generation = prepareTypeAppApplication($root);
        foreach ($generation['files'] as $generated) {
            require $generation['directory'] . '/' . $generated;
        }
    } else {
        // help 只声明应用入口，不要求 Composer、开发生成结果或有效 .env。
        require $root . '/app/common/bootstrap/Application.php';
    }
    // 明确的开发权限入参，不通过 putenv 覆盖使用者配置，更不由 HTTP 输入开启。
    exit(app\common\bootstrap\Application::run($argv, true));
} catch (Throwable $error) {
    fwrite(STDERR, 'TypeApp 开发启动失败：' . $error->getMessage() . "\n");
    exit(1);
}
