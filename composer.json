{
  "name": "zoujingli/typeapp",
  "description": "TypeApp：以 TypePHP 全量编译、Swoole 驱动运行、Plugins 组合能力的 PHP 应用框架。",
  "homepage": "https://github.com/zoujingli/typeapp",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4 <8.6",
    "ext-swoole": ">=6.2 <7",
    "zoujingli/type-core": "~1.0.0@dev",
    "zoujingli/type-log": "~1.0.0@dev",
    "zoujingli/type-mqtt": "~1.0.0@dev",
    "zoujingli/type-orm-mysql": "~1.0.0@dev",
    "zoujingli/type-orm-pgsql": "~1.0.0@dev",
    "zoujingli/type-orm-sqlite": "~1.0.0@dev",
    "zoujingli/type-runtime": "~1.0.0@dev",
    "zoujingli/type-redis": "~1.0.0@dev",
    "zoujingli/type-cache": "~1.0.0@dev",
    "zoujingli/type-queue": "~1.0.0@dev",
    "zoujingli/type-scheduler": "~1.0.0@dev",
    "zoujingli/type-validate": "~1.0.0@dev"
  },
  "require-dev": {
    "swoole/ide-helper": ">=6.2.2",
    "friendsofphp/php-cs-fixer": "3.95.25",
    "phpunit/phpunit": "13.3.3",
    "zoujingli/type-build": "~1.0.0@dev",
    "zoujingli/type-testing": "~1.0.0@dev"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "plugin/*",
      "options": {
        "symlink": true,
        "versions": {
          "zoujingli/type-runtime": "1.0.x-dev",
          "zoujingli/type-build": "1.0.x-dev",
          "zoujingli/type-testing": "1.0.x-dev",
          "zoujingli/type-core": "1.0.x-dev",
          "zoujingli/type-log": "1.0.x-dev",
          "zoujingli/type-mqtt": "1.0.x-dev",
          "zoujingli/type-orm": "1.0.x-dev",
          "zoujingli/type-orm-mysql": "1.0.x-dev",
          "zoujingli/type-orm-pgsql": "1.0.x-dev",
          "zoujingli/type-orm-sqlite": "1.0.x-dev",
          "zoujingli/type-validate": "1.0.x-dev",
          "zoujingli/type-redis": "1.0.x-dev",
          "zoujingli/type-cache": "1.0.x-dev",
          "zoujingli/type-queue": "1.0.x-dev",
          "zoujingli/type-scheduler": "1.0.x-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "scripts": {
    "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --using-cache=no --sequential",
    "cs-fix": "@php vendor/bin/php-cs-fixer fix --using-cache=no --sequential",
    "test:unit": "@php vendor/bin/phpunit --configuration phpunit.xml",
    "test:configuration-root": "@php tests/configuration-root.php",
    "typeapp": "@php bin/typeapp",
    "typeapp:prepare": "@php bin/typeapp-prepare",
    "test:iot-identity": "@php tests/iot-identity.php --php sqlite --app",
    "test:iot-identity-native": "@php tests/iot-identity.php build/app/type-app sqlite --app",
    "test:iot-identity-databases": [
      "Composer\\Config::disableProcessTimeout",
      "@php tests/iot-identity-databases.php"
    ],
    "typeapp:migrate": "@php bin/typeapp migrate",
    "typeapp:serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/typeapp serve"
    ],
    "typeapp:build": "@php vendor/bin/type docs/build-config/type-app.json",
