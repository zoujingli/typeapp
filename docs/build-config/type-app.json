{
  "project-root": "../..",
  "name": "typeapp",
  "version": "1.0.0-dev",
  "development": {
    "entry": "bin/typeapp",
    "prepare": "bin/typeapp-prepare",
    "output": "build/app/development",
    "check": [
      "check"
    ],
    "watch": [
      "plugin"
    ]
  },
  "sources": [
    "app"
  ],
  "migrations": "database/migrations",
  "embedded-resources": [
    {
      "source": "web/dist",
      "target": "web"
    }
  ],
  "build-profiles": {
    "sqlite": {
      "database": "sqlite",
      "features": [
        "web",
        "mqtt",
        "iot",
        "scheduler"
      ]
    },
    "mysql": {
      "database": "mysql",
      "features": [
        "web",
        "mqtt",
        "iot",
        "scheduler"
      ]
    },
    "pgsql": {
      "database": "pgsql",
      "features": [
        "web",
        "mqtt",
        "iot",
        "scheduler"
      ]
    }
  },
  "threads": {
    "http": "app\\common\\bootstrap\\Application::httpThread"
  },
  "runtime": {
    "Linux": {
      "extensions": [
        "pcntl",
        "swoole"
      ],
      "functions": [
        "pcntl_signal",
        "pcntl_async_signals",
        "pcntl_signal_get_handler"
      ]
    },
    "Darwin": {
      "extensions": [
        "pcntl",
        "swoole"
      ],
      "functions": [
        "pcntl_signal",
        "pcntl_async_signals",
        "pcntl_signal_get_handler"
      ]
    }
  },
  "routing": "config/route.php",
  "config": {
    "class": "app\\generated\\ProjectConfig",
    "files": [
      "config/app.php",
      "config/database.php",
      "config/cache.php"
    ]
  },
  "output": "build/app/type-app",
  "build-directory": "build/app/compiler",
  "application": {
    "enabled": [
      "zoujingli/typeapp"
    ],
    "bootstrap": {
      "class": "app\\common\\bootstrap\\Application",
      "method": "bootstrap"
    },
    "config": {
      "base": {
        "env": "TYPEAPP_BOOTSTRAP_BASE",
        "default": ""
      },
      "program": {
        "env": "TYPEAPP_BOOTSTRAP_PROGRAM",
        "default": ""
      },
      "development": {
        "env": "TYPEAPP_BOOTSTRAP_DEVELOPMENT",
        "default": ""
      },
      "settings": {
        "env": "TYPEAPP_BOOTSTRAP_SETTINGS",
        "default": ""
      }
    },
    "services": [
      {
        "id": "application.context",
        "class": "app\\common\\bootstrap\\ApplicationContext",
        "lifetime": "singleton",
        "arguments": [
          {
            "config": "base"
          },
          {
            "config": "program"
          },
          {
            "config": "development"
          },
          {
            "config": "settings"
          }
        ]
      },
      {
        "id": "http.messages",
        "class": "Type\\Core\\Http\\Message\\Factory",
        "lifetime": "singleton"
      },
      {
        "id": "identity.platform",
        "class": "app\\common\\service\\IdentityService",
        "arguments": [
          {
            "value": "platform"
          }
        ]
      },
      {
        "id": "auth.platform",
        "class": "app\\common\\middleware\\IdentityAuthentication",
        "arguments": [
          {
            "service": "identity.platform"
          },
          {
            "service": "http.messages"
          }
        ]
      },
      {
        "id": "identity.system",
        "class": "app\\common\\service\\IdentityService",
        "arguments": [
          {
            "value": "system"
          }
        ]
      },
      {
        "id": "auth.system",
        "class": "app\\common\\middleware\\IdentityAuthentication",
        "arguments": [
          {
            "service": "identity.system"
          },
          {
            "service": "http.messages"
          }
        ]
      },
      {
        "id": "auth.probe",
        "class": "app\\common\\middleware\\ProbeAuthentication"
      },
      {
        "id": "command.check",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "check"
          }
        ]
      },
      {
        "id": "command.verify-runtime",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "verify-runtime"
          }
        ]
      },
      {
        "id": "command.licenses",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "licenses"
          }
        ]
      },
      {
        "id": "command.config:check",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "config:check"
          }
        ]
      },
      {
        "id": "command.config:restore",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "config:restore"
          }
        ]
      },
      {
        "id": "command.app:install",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "app:install"
          }
        ]
      },
      {
        "id": "command.web:install",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "web:install"
          }
        ]
      },
      {
        "id": "command.app:upgrade",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "app:upgrade"
          }
        ]
      },
      {
        "id": "command.app:schedule",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "app:schedule"
          }
        ]
      },
      {
        "id": "command.migrate",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "migrate"
          }
        ]
      },
      {
        "id": "command.center:backup",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:backup"
          }
        ]
      },
      {
        "id": "command.center:wal",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:wal"
          }
        ]
      },
      {
        "id": "command.center:recovery",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:recovery"
          }
        ]
      },
      {
        "id": "command.app:audit-clean",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "app:audit-clean"
          }
        ]
      },
      {
        "id": "command.center:mqtt-install",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-install"
          }
        ]
      },
      {
        "id": "command.center:mqtt-statistics",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-statistics"
          }
        ]
      },
      {
        "id": "command.center:mqtt-nodes",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-nodes"
          }
        ]
      },
      {
        "id": "command.center:mqtt-fence",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-fence"
          }
        ]
      },
      {
        "id": "command.center:mqtt-fence-result",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-fence-result"
          }
        ]
      },
      {
        "id": "command.center:mqtt-store",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-store"
          }
        ]
      },
      {
        "id": "command.center:mqtt-access",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "center:mqtt-access"
          }
        ]
      },
      {
        "id": "command.broker:store-install",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "broker:store-install"
          }
        ]
      },
      {
        "id": "command.broker:store",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "broker:store"
          }
        ]
      },
      {
        "id": "command.broker:nodes",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "broker:nodes"
          }
        ]
      },
      {
        "id": "command.broker:node-fence",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "broker:node-fence"
          }
        ]
      },
      {
        "id": "command.broker:node-fence-result",
        "class": "app\\common\\bootstrap\\ManagementCommand",
        "arguments": [
          {
            "service": "application.context"
          },
          {
            "value": "broker:node-fence-result"
          }
        ]
      },
      {
        "id": "audit.platform",
        "class": "app\\common\\service\\AuditRetentionTask",
        "arguments": [
          {
            "value": "platform"
          }
        ]
      },
      {
        "id": "audit.system",
        "class": "app\\common\\service\\AuditRetentionTask",
        "arguments": [
          {
            "value": "system"
          }
        ]
      },
      {
        "id": "body.json",
        "class": "app\\common\\middleware\\JsonBody"
      }
    ],
    "bindings": [],
    "commands": [
      {
        "name": "app:check",
        "service": "command.check"
      },
      {
        "name": "verify-runtime",
        "service": "command.verify-runtime"
      },
      {
        "name": "licenses",
        "service": "command.licenses"
      },
      {
        "name": "config:check",
        "service": "command.config:check"
      },
      {
        "name": "config:restore",
        "service": "command.config:restore"
      },
      {
        "name": "app:install",
        "service": "command.app:install"
      },
      {
        "name": "web:install",
        "service": "command.web:install"
      },
      {
        "name": "app:upgrade",
        "service": "command.app:upgrade"
      },
      {
        "name": "app:schedule",
        "service": "command.app:schedule"
      },
      {
        "name": "migrate",
        "service": "command.migrate"
      },
      {
        "name": "center:backup",
        "service": "command.center:backup"
      },
      {
        "name": "center:wal",
        "service": "command.center:wal"
      },
      {
        "name": "center:recovery",
        "service": "command.center:recovery"
      },
      {
        "name": "app:audit-clean",
        "service": "command.app:audit-clean"
      },
      {
        "name": "center:mqtt-install",
        "service": "command.center:mqtt-install"
      },
      {
        "name": "center:mqtt-statistics",
        "service": "command.center:mqtt-statistics"
      },
      {
        "name": "center:mqtt-nodes",
        "service": "command.center:mqtt-nodes"
      },
      {
        "name": "center:mqtt-fence",
        "service": "command.center:mqtt-fence"
      },
      {
        "name": "center:mqtt-fence-result",
        "service": "command.center:mqtt-fence-result"
      },
      {
        "name": "center:mqtt-store",
        "service": "command.center:mqtt-store"
      },
      {
        "name": "center:mqtt-access",
        "service": "command.center:mqtt-access"
      },
      {
        "name": "broker:store-install",
        "service": "command.broker:store-install"
      },
      {
        "name": "broker:store",
        "service": "command.broker:store"
      },
      {
        "name": "broker:nodes",
        "service": "command.broker:nodes"
      },
      {
        "name": "broker:node-fence",
        "service": "command.broker:node-fence"
      },
      {
        "name": "broker:node-fence-result",
        "service": "command.broker:node-fence-result"
      }
    ],
    "http": {
      "middleware": {
        "platform.auth": "auth.platform",
        "system.auth": "auth.system",
        "body.json": "body.json",
        "mqtt.probe": "auth.probe"
      }
    },
    "jobs": [],
    "schedules": [
      {
        "id": "audit.platform",
        "service": "audit.platform",
        "schedule": {
          "interval": 60
        },
        "misfire": "skip",
        "grace-seconds": 59,
        "lookback-seconds": 3600,
        "catch-up-limit": 1
      },
      {
        "id": "audit.system",
        "service": "audit.system",
        "schedule": {
          "interval": 60
        },
        "misfire": "skip",
        "grace-seconds": 59,
        "lookback-seconds": 3600,
        "catch-up-limit": 1
      }
    ]
  }
}
