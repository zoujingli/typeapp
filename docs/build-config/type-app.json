      {
        "id": "audit.admin",
        "service": "audit.admin",
        "schedule": {
          "interval": 60
        },
        "misfire": "skip",
        "grace-seconds": 59,
        "lookback-seconds": 3600,
        "catch-up-limit": 1
      },
      {
        "id": "audit.customer",
        "service": "audit.customer",
        "schedule": {
          "interval": 60
        },
        "misfire": "skip",
