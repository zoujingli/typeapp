{
  "project-root": "../..",
  "name": "typeapp",
  "version": "1.0.0-dev",
  "development": {
    "entry": "bin/typeapp",
    "prepare": "bin/typeapp-prepare",
    "output": "build/app/development",
    "check": [
      "check"
    ],
    "watch": [
      "plugin"
    ]
  },
  "sources": [
    "app"
  ],
  "embedded-resources": [
    {
      "source": "web/dist",
      "target": "web"
    }
  ],
  "build-profiles": {
    "sqlite": {
      "database": "sqlite",
      "features": [
        "web",
        "mqtt",
        "iot",
        "alerts",
        "exports",
        "queue",
        "scheduler"
      ]
    },
    "mysql": {
      "database": "mysql",
      "features": [
        "web",
        "mqtt",
        "iot",
        "alerts",
        "exports",
        "queue",
        "scheduler"
      ]
    },
    "pgsql": {
      "database": "pgsql",
      "features": [
        "web",
        "mqtt",
        "iot",
        "alerts",
        "exports",
        "queue",
        "scheduler"
      ]
    }
  },
  "threads": {
    "http": "app\\common\\bootstrap\\Application::httpThread"
  },
  "runtime": {
    "Linux": {
      "extensions": [
        "pcntl",
        "swoole"
      ],
      "functions": [
        "pcntl_signal",
        "pcntl_async_signals",
        "pcntl_signal_get_handler"
      ]
    },
    "Darwin": {
      "extensions": [
        "pcntl",
        "swoole"
      ],
      "functions": [
        "pcntl_signal",
        "pcntl_async_signals",
        "pcntl_signal_get_handler"
      ]
    }
  },
  "routing": "config/route.php",
  "config": {
    "class": "app\\generated\\ProjectConfig",
    "files": [
      "config/app.php",
      "config/database.php",
      "config/cache.php"
    ]
  },
  "output": "build/app/type-app",
  "build-directory": "build/app/compiler",
  "application": {
    "enabled": [
      "zoujingli/typeapp"
    ],
    "bootstrap": {
      "class": "app\\common\\bootstrap\\Application",
      "method": "bootstrap"
    },
    "config": {
      "base": {
        "env": "TYPEAPP_BOOTSTRAP_BASE",
        "default": ""
      },
      "program": {
        "env": "TYPEAPP_BOOTSTRAP_PROGRAM",
        "default": ""
      },
      "development": {
        "env": "TYPEAPP_BOOTSTRAP_DEVELOPMENT",
        "default": ""
      },
      "settings": {
        "env": "TYPEAPP_BOOTSTRAP_SETTINGS",
        "default": ""
      }
    },
    "services": [
      {
        "id": "application.context",
        "class": "app\\common\\bootstrap\\ApplicationContext",
        "lifetime": "singleton",
        "arguments": [
          {
            "config": "base"
          },
          {
            "config": "program"
          },
          {
            "config": "development"
          },
          {
            "config": "settings"
          }
        ]
      },
      {
        "id": "http.messages",
        "class": "Type\\Core\\Http\\Message\\Factory",
        "lifetime": "singleton"
      },
      {
        "id": "identity.admin",
        "class": "app\\common\\service\\IdentityService",
        "arguments": [
          {
            "value": "admin"
          }
        ]
      },
      {
        "id": "auth.admin",
        "class": "app\\iot\\middleware\\IotAuthentication",
        "arguments": [
          {
            "service": "identity.admin"
          },
          {
            "service": "http.messages"
          }
        ]
      },
      {
        "id": "identity.customer",
