# 每个投票者使用自己的名称和可验证DNS；以下为iot_a，另两节点替换本节点字段。
# 相对文件路径基于各自私有运行目录；端口仅向集群和获准管理入口开放。
ETCD_NAME=iot_a
ETCD_DATA_DIR=data
ETCD_LISTEN_CLIENT_URLS=https://etcd-a.iot.internal:2379
ETCD_ADVERTISE_CLIENT_URLS=https://etcd-a.iot.internal:2379
ETCD_LISTEN_CLIENT_HTTP_URLS=https://etcd-a.iot.internal:2381
ETCD_LISTEN_PEER_URLS=https://etcd-a.iot.internal:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://etcd-a.iot.internal:2380
ETCD_INITIAL_CLUSTER=iot_a=https://etcd-a.iot.internal:2380,iot_b=https://etcd-b.iot.internal:2380,iot_c=https://etcd-c.iot.internal:2380
ETCD_INITIAL_CLUSTER_TOKEN=typeapp-iot
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_CERT_FILE=tls/server.crt
ETCD_KEY_FILE=tls/server.key
ETCD_TRUSTED_CA_FILE=tls/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE=tls/peer.crt
ETCD_PEER_KEY_FILE=tls/peer.key
ETCD_PEER_TRUSTED_CA_FILE=tls/ca.crt
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_LOG_LEVEL=info
