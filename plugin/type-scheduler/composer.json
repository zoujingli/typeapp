{
  "name": "zoujingli/type-scheduler",
  "description": "TypeApp 任务调度组件：Cron、固定间隔、时区、有限补跑与独立作用域执行。",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4 <8.6",
    "dragonmantank/cron-expression": "~3.6.0",
    "psr/clock": "~1.0.0",
    "zoujingli/type-runtime": "~1.0.0@dev",
    "zoujingli/type-redis": "~1.0.0@dev"
  },
  "autoload": {
    "psr-4": {
      "Type\\Scheduler\\": "src/"
    }
  },
  "extra": {
    "type": {
      "protocol": 1,
      "sources": [
        "src"
      ],
      "imports": {
        "dragonmantank/cron-expression": {
          "protocol": 1,
          "version": "3.6.0",
          "sources": [
            "src/Cron"
          ],
          "rewrites": [
            {
              "source": "src/Cron/AbstractField.php",
              "sha256": "8aa149c3b534521fa552711ef2fac2b358cc6bee4a17fcb7cb91068062c56935",
              "reason": "避免 TypePHP 将同一字符串参数重新推断为整数；保留 Cron 原判断语义。",
              "replacements": [
                {
                  "from": "        $value = (int) $value;\n\n        return \\in_array($value, $this->fullRange, true);",
                  "to": "        $integerValue = (int) $value;\n\n        return \\in_array($integerValue, $this->fullRange, true);",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/CronExpression.php",
              "sha256": "d257d01d5f331236e20854c4b0bb611e8dbcc41d9f2c09fa1398a30e00027ca2",
              "reason": "区分表达式文本与对象，并按TypePHP 0.9显式传递动态日期引用，保持日期合并、克隆和写回语义。",
              "replacements": [
                {
                  "from": "$domExpression = sprintf(",
                  "to": "$domPattern = sprintf(",
                  "count": 1
                },
                {
                  "from": "$dowExpression = sprintf(",
                  "to": "$dowPattern = sprintf(",
                  "count": 1
                },
                {
                  "from": "$domExpression = new self($domExpression);",
                  "to": "$domExpression = new self($domPattern);",
                  "count": 1
                },
                {
                  "from": "$dowExpression = new self($dowExpression);",
                  "to": "$dowExpression = new self($dowPattern);",
                  "count": 1
                },
                {
                  "from": "$nextRun = clone $currentDate;",
                  "to": "$nextRun = \\std::any(clone $currentDate);",
                  "count": 1
                },
                {
                  "from": "->increment($nextRun,",
                  "to": "->increment(\\std::ref($nextRun),",
                  "count": 2
                }
              ]
            },
            {
              "source": "src/Cron/FieldInterface.php",
              "sha256": "158a32eded9733c46b9eb36dc61280aa5dfbd03cf7882ed4f6cd9aabdafca79a",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/DayOfMonthField.php",
              "sha256": "b69d63d2a2890106c1bc544f31cb8df097012018bfb845f97b4d23ca3df538eb",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/DayOfWeekField.php",
              "sha256": "e10b47a3189aeec98681f699b8ecf2ea216e8f7b87f3aab8ed92618f06fd2f79",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/HoursField.php",
              "sha256": "8e4693f16203ceea8aad5d322b9add6a1682c2dd4f3d640700832a4612c00e81",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/MinutesField.php",
              "sha256": "bc18b0bb62c77105583e1e09526fb20a57fcc3e2557619faeb2dc3325c4d0bb9",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            },
            {
              "source": "src/Cron/MonthField.php",
              "sha256": "96ef40989010fba773e494f35e378894a18a9e08def04508995328aa74c49b49",
              "reason": "PHP的DateTimeInterface仅由DateTime和DateTimeImmutable及其子类实现；等价联合类型保留对象引用写回，同时满足TypePHP 0.9的引用存储边界。",
              "replacements": [
                {
                  "from": "DateTimeInterface &$date",
                  "to": "\\DateTime|\\DateTimeImmutable &$date",
                  "count": 1
                }
              ]
            }
          ]
        },
        "psr/clock": {
          "protocol": 1,
          "version": "1.0.0",
          "sources": [
            "src"
          ]
        }
      }
    },
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    }
  }
}
