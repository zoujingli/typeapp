{
  "name": "iot-baseline-v1",
  "seed": "typeapp-iot-baseline-v1-20260914",
  "tenants": 100,
  "products_per_tenant": 10,
  "devices_per_product": 10,
  "telemetry_interval_ms": 10000,
  "alarm_cycle_seconds": 600,
  "alarm_device_modulus": 100,
  "event_interval_seconds": 600,
  "command_interval_seconds": 60,
  "web_sessions": 100,
  "web_interval_ms": 5000,
  "cache_maximum_records": 10000,
  "cache_maximum_bytes": 16777216,
  "model": {
    "properties": [
      {"identifier":"ambient_temperature","name":"温度","type":"number","required":true,"unit":"°C","min":-40,"max":125},
      {"identifier":"relative_humidity","name":"湿度","type":"number","required":true,"unit":"%RH","min":0,"max":100},
      {"identifier":"inlet_pressure","name":"压力","type":"number","required":true,"unit":"kPa","min":0,"max":2000},
      {"identifier":"supply_voltage","name":"电压","type":"number","required":true,"unit":"V","min":0,"max":400},
      {"identifier":"supply_current","name":"电流","type":"number","required":true,"unit":"A","min":0,"max":100},
      {"identifier":"active_power","name":"有功功率","type":"number","required":true,"unit":"kW","min":0,"max":100},
      {"identifier":"reactive_power","name":"无功功率","type":"number","required":true,"unit":"kvar","min":-100,"max":100},
      {"identifier":"power_factor","name":"功率因数","type":"number","required":true,"unit":"1","min":0,"max":1},
