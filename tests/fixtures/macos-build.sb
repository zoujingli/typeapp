(version 1)
(deny default)
(allow process*)
(allow sysctl-read)
(allow mach-lookup)
(allow file-read-metadata)
(allow file-read-data (literal (param "ROOT")))
(allow file-read* file-map-executable
    (subpath (param "SYSTEM"))
    (subpath (param "DYLD"))
    (subpath (param "TOOLS"))
    (subpath (param "BIN"))
    (subpath (param "DEVELOPER"))
    (subpath (param "PACKAGES"))
    (subpath (param "PHP"))
    (subpath (param "PHPX"))
    (subpath (param "EXTRA0"))
    (subpath (param "INPUT"))
    (subpath (param "SCRATCH"))
    (literal (param "SSL_CONFIG"))
    (literal (param "NULL")))
(allow file-write*
    (subpath (param "BUILD"))
    (subpath (param "SCRATCH"))
    (literal (param "NULL")))
